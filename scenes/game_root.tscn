[node name="TopSpacer" type="Control" parent="L1Root/TableUI/Layout"]
## L1-5 defect #4 fix: DealerHandView used to be the Layout's first child,
## pinned to TableUI's top margin. That was only safe while DealerIdleView
## filled the whole screen (the cards landed on the hair bun, above the
## face). Once defect #3 confined the dealer to the upper 53.7% of the
## canvas, that same fixed top position put the cards squarely on the
## dealer's eyes instead (docs/01 §1: Dealer is the primary visual focus;
## the six L2 facial-reaction assets would never be seen with the face
## covered). This spacer — an EXPAND_FILL Control sharing the Layout's
## flexible middle space with CenterSpacer at a 3:1 ratio — pushes
## DealerHandView down to roughly the table-edge line instead (cards
## dealt onto the table reads as more natural than cards floating beside
## a face anyway), expressed as a stretch ratio rather than a fixed pixel
## offset so it holds across all three reference viewport sizes.
layout_mode = 2
size_flags_vertical = 3
size_flags_stretch_ratio = 3.0

[node name="DealerHandView" type="HBoxContainer" parent="L1Root/TableUI/Layout"]
layout_mode = 2
size_flags_horizontal = 4
theme_override_constants/separation = 16

