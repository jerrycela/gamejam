layout_mode = 2
suit = 3
rank = "A"

[node name="DealerCard2" parent="L1Root/TableUI/Layout/DealerHandView" instance=ExtResource("2")]
layout_mode = 2
suit = 1
rank = "10"

[node name="CenterSpacer" type="Control" parent="L1Root/TableUI/Layout"]
## Reserved for L3 (docs/01_GAME_AND_LAYER_SPEC.md:29 / team-lead-approved
## zoning). Previously the *only* flexible gap, sitting below DealerHandView
## and above BottomCluster; now shares that role with TopSpacer above (see
## its comment) at a 1:3 ratio, so most of the flexible space goes above
## the dealer's hand and this keeps a smaller reserved gap between the
## dealer's hand and BottomCluster. SIZE_EXPAND_FILL + an explicit
## stretch ratio (not a fixed pixel gap) is what makes both spacers reflow
## together across L1-5's three viewport sizes instead of drifting.
layout_mode = 2
size_flags_vertical = 3
size_flags_stretch_ratio = 1.0

[node name="ResultBanner" type="Label" parent="L1Root/TableUI/Layout/CenterSpacer"]
## Transient result text (WIN/LOSE/PUSH/...) is the one L1 element allowed to
## sit inside the L3-reserved zone: it is empty most of the time and only
## shown briefly, unlike a persistent background/texture.
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
horizontal_alignment = 1
vertical_alignment = 1
text = ""

