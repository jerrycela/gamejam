[node name="CenterSpacer" type="Control" parent="L1Root/TableUI/Layout"]
## Reserved for L3 (docs/01_GAME_AND_LAYER_SPEC.md:29 / team-lead-approved
## zoning: dealer hand pinned to top edge, player hand + ActionBar pinned to
## bottom edge, center left empty so L3's Dealer/background stays visible).
## SIZE_EXPAND_FILL makes it consume all leftover vertical space at any
## viewport height/aspect instead of a fixed pixel gap, so L1-5's three
## viewport sizes reflow instead of the top/bottom clusters drifting toward
## the middle or off-screen.
layout_mode = 2
size_flags_vertical = 3

[node name="ResultBanner" type="Label" parent="L1Root/TableUI/Layout/CenterSpacer"]
## Transient result text (WIN/LOSE/PUSH/...) is the one L1 element allowed to
## sit inside the L3-reserved zone: it is empty most of the time and only
## shown briefly, unlike a persistent background/texture.
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
horizontal_alignment = 1
vertical_alignment = 1
text = ""

